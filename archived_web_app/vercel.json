{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(index\\.html|admin-dashboard\\.html|dashboard\\.html|style\\.css|dashboard\\.js|admin-dashboard\\.js|modal\\.js|app\\.js)",
      "dest": "frontend/$1"
    },
    {
      "src": "/",
      "dest": "frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "backend/server.js"
    }
  ]
}
